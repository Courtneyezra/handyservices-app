# An example of the environment variables this file documents. It is not a complete list of what
# the app reads. Copy a line into your own .env or into Railway's Variables; never commit real values.

# Inbound email from Resend (docs/RUNBOOK.md, "Inbound email (Resend)"). Off unless set to 1, and it
# also needs COMMS_V2_INTAKE=1.
COMMS_V2_EMAIL_INBOUND=
# The signing secret (whsec_...) from the Resend webhook for the email.received event.
RESEND_INBOUND_WEBHOOK_SECRET=
# Resend's API key. It already sends the business's email; inbound email uses it to read each
# received email's body and attachments.
RESEND_API_KEY=
