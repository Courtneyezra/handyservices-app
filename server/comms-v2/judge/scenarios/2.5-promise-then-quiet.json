{
  "id": "2.5-promise-then-quiet",
  "title": "A real promise (\"I'll send photos tomorrow\") gets one acknowledgement, then quiet until the customer writes",
  "lines": ["2.5"],
  "door": "whatsapp",
  "seed": { "customer": "new", "name": "Sara", "prefersText": false, "alreadyRung": false, "window": "open" },
  "turns": [
    {
      "from": "customer", "kind": "message",
      "text": "Hi, three fence panels have blown down in the storm. We're NG9 5AB, can you quote to replace them?",
      "expect": []
    },
    {
      "from": "customer", "kind": "message",
      "text": "I'll send photos tomorrow when I'm home.",
      "expect": [
        { "line": "2.5", "kind": "reply_sent", "note": "one acknowledgement, not silence" },
        { "line": "2.5", "kind": "bubble_count_within", "max": 4 }
      ]
    },
    {
      "from": "system", "kind": "clock",
      "expect": [
        { "line": "2.5", "kind": "reply_not_sent", "note": "then quiet" }
      ]
    },
    {
      "from": "system", "kind": "clock",
      "expect": [
        { "line": "2.5", "kind": "reply_not_sent", "note": "still quiet until they write" }
      ]
    }
  ]
}
