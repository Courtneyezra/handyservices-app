{
  "id": "1.7-photos-first",
  "title": "Photos with the first message are acknowledged as photos, not as a bare enquiry",
  "lines": ["1.7"],
  "door": "whatsapp",
  "seed": { "customer": "new", "name": "Priya", "prefersText": false, "alreadyRung": false, "window": "open" },
  "turns": [
    {
      "from": "customer", "kind": "message",
      "text": "Hi, this is the tap that's leaking under our kitchen sink. Can you quote for fixing it?",
      "media": [{ "file": "leaking-tap.png", "mime": "image/png" }],
      "expect": [
        { "line": "1.7", "kind": "reply_sent" },
        { "line": "1.7", "kind": "text_matches", "pattern": "\\b(?:photo|photos|picture|pictures|pic|pics|image|images|snap)\\b", "note": "acknowledged as photos" }
      ]
    }
  ]
}
